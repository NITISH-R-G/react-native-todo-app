# Copy to .env for local use (gitignored). In production set these as platform secrets/variables, never in the image or repo.

# --- required ---
MONGODB_URI=mongodb://127.0.0.1:27017/todo
JWT_ACCESS_SECRET=change-me-at-least-32-random-characters
JWT_REFRESH_SECRET=a-different-secret-at-least-32-random-chars

# --- server ---
PORT=4000
# Reverse-proxy hops in front of the app (0 = none). Set 1 behind a typical PaaS/load balancer so client IPs
# (rate limiting) and the original protocol are correct.
TRUST_PROXY=0
# Reject plain HTTP (needs TRUST_PROXY>=1 and a proxy that sets X-Forwarded-Proto). Health checks are exempt.
REQUIRE_HTTPS=false
# JSON request log lines (method, path, status, ms; never bodies/headers/query).
LOG_REQUESTS=false
# Browser origins allowed by CORS (comma separated). Leave empty: the native app sends no Origin.
CORS_ORIGINS=

# --- tuning (defaults shown) ---
JWT_ACCESS_TTL=15m
REFRESH_REUSE_GRACE_SECONDS=30
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
